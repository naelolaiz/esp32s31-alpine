#!/bin/sh
# Switches on the chip's temperature sensor at boot, for Alpine on
# GrieferPig's kernel. Runs from OpenRC's "local" service.
#
# His kernel has the driver built in, but the sensor's device-tree node is
# disabled. Writing the overlay to his overlay manager enables the node;
# the driver then registers the hwmon device "esp32s31_tsens"
# (/sys/class/hwmon/hwmonN, read by lm-sensors). An applied overlay lasts
# until the next reboot, so this runs at every boot.
#
# The overlay is built from grieferpig/overlays/esp32s31-overlay-tsens.dtso.
#
# Every command and its output go to /var/log/tsens.log: OpenRC sends the
# output of local.d scripts to /dev/null unless it runs verbose.

exec >/var/log/tsens.log 2>&1
set -x

dtbo=/usr/local/lib/s31-overlays/esp32s31-overlay-tsens.dtbo

# Already on: the script ran before, or the overlay came from elsewhere.
if grep -qx esp32s31_tsens /sys/class/hwmon/hwmon*/name 2>/dev/null; then
	exit 0
fi

if [ ! -c /dev/s31-overlay ]; then
	echo "tsens.start: no /dev/s31-overlay, this is not GrieferPig's kernel"
	exit 0
fi

# One write of the whole file is one overlay for the manager.
cat "$dtbo" >/dev/s31-overlay
