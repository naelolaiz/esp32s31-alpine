From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: alpine-riscv32 <alpine-riscv32@users.noreply.github.com>
Date: Sat, 10 Oct 2026 21:10:00 +0000
Subject: [PATCH 2/3] riscv: support harts with F but without D

The ESP32-S31 cores implement the single-precision F extension but not
D. Linux only supports F together with D: riscv_ext_f_validate() drops
F when D is missing, riscv_fill_hwcap() masks it out of the hwcap, and
__fstate_save()/__fstate_restore() use the double-precision fsd/fld,
which are illegal on such a hart.

Add CONFIG_FPU_F_ONLY. With it, F is accepted without D, the context
switch saves and restores the 32 registers with fsw/flw into the low
half of the existing 64-bit slots, so the signal frame and ptrace
layouts do not change, and D is ignored should a device tree list it.
It defaults to y for ARCH_ESPRESSIF.
---
 arch/riscv/Kconfig             |  15 ++++
 arch/riscv/kernel/cpufeature.c |  16 +++-
 arch/riscv/kernel/fpu.S        | 137 ++++++++++++++++++---------------
 3 files changed, 100 insertions(+), 68 deletions(-)

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 7cdd51c89..45a392a68 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -894,6 +894,21 @@ config FPU
 	  boot. When this option is disabled, neither the kernel nor userspace
 	  may use the floating point unit.
 
+config FPU_F_ONLY
+	bool "FPU support for harts with F but without D"
+	depends on FPU && 32BIT
+	default y if ARCH_ESPRESSIF
+	help
+	  Some RV32 cores, such as the Espressif ESP32-S31, implement the
+	  single-precision F extension without D. Without this option the
+	  kernel ignores F on such harts.
+
+	  With it, the kernel accepts F without D and saves and restores the
+	  floating point registers with single-precision loads and stores.
+	  The 64-bit register slots of the signal frame and ptrace layout stay
+	  as they are, with the value in the low 32 bits. D is ignored, so say
+	  Y only for systems whose harts have F and no D.
+
 	  If you don't know what to do here, say Y.
 
 config IRQ_STACKS
diff --git a/arch/riscv/kernel/cpufeature.c b/arch/riscv/kernel/cpufeature.c
index 72ca768f4..76b277fc1 100644
--- a/arch/riscv/kernel/cpufeature.c
+++ b/arch/riscv/kernel/cpufeature.c
@@ -145,7 +145,8 @@ static int riscv_ext_f_validate(const struct riscv_isa_ext_data *data,
 	 * Due to extension ordering, d is checked before f, so no deferral
 	 * is required.
 	 */
-	if (!__riscv_isa_extension_available(isa_bitmap, RISCV_ISA_EXT_d)) {
+	if (!IS_ENABLED(CONFIG_FPU_F_ONLY) &&
+	    !__riscv_isa_extension_available(isa_bitmap, RISCV_ISA_EXT_d)) {
 		pr_warn_once("This kernel does not support systems with F but not D\n");
 		return -EINVAL;
 	}
@@ -159,6 +160,12 @@ static int riscv_ext_d_validate(const struct riscv_isa_ext_data *data,
 	if (!IS_ENABLED(CONFIG_FPU))
 		return -EINVAL;
 
+	/* The F-only context switch would lose the upper half of D registers. */
+	if (IS_ENABLED(CONFIG_FPU_F_ONLY)) {
+		pr_warn_once("D ignored: kernel built with CONFIG_FPU_F_ONLY\n");
+		return -EINVAL;
+	}
+
 	return 0;
 }
 
@@ -1077,10 +1084,11 @@ void __init riscv_fill_hwcap(void)
 	}
 
 	/*
-	 * We don't support systems with F but without D, so mask those out
-	 * here.
+	 * We don't support systems with F but without D, unless built with
+	 * CONFIG_FPU_F_ONLY, so mask those out here.
 	 */
-	if ((elf_hwcap & COMPAT_HWCAP_ISA_F) && !(elf_hwcap & COMPAT_HWCAP_ISA_D)) {
+	if (!IS_ENABLED(CONFIG_FPU_F_ONLY) &&
+	    (elf_hwcap & COMPAT_HWCAP_ISA_F) && !(elf_hwcap & COMPAT_HWCAP_ISA_D)) {
 		pr_info("This kernel does not support systems with F but not D\n");
 		elf_hwcap &= ~COMPAT_HWCAP_ISA_F;
 	}
